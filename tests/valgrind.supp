# Valgrind suppressions for third-party SDL2 start-up internals only.
{
   sdl_startup_sdl_init_leak
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_cond
   Memcheck:Cond
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_value8
   Memcheck:Value8
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_value4
   Memcheck:Value4
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_addr1
   Memcheck:Addr1
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_addr2
   Memcheck:Addr2
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_addr4
   Memcheck:Addr4
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_addr8
   Memcheck:Addr8
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_addr16
   Memcheck:Addr16
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_param
   Memcheck:Param
   *
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_overlap
   Memcheck:Overlap
   ...
   fun:SDL_Init*
   ...
}
{
   sdl_startup_sdl_init_free
   Memcheck:Free
   ...
   fun:SDL_Init*
   ...
}
